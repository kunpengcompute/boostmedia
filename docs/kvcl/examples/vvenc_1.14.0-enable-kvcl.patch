+template<typename G>
+static bool check_one_KVCL_DCT2(TCoeffOps* ref, unsigned idx, unsigned trSize, unsigned line,
+                                      unsigned reducedLine, unsigned cutoff, G input_generator,
+                                      double& elapsed_vvenc_us, double& elapsed_kvcl_us)
+{
+  CHECK( line == 0, "Line must be non-zero" );
+  CHECK( reducedLine > line, "ReducedLine must be less than or equal to line" );
+  CHECK( cutoff == 0, "Cutoff must be non-zero" );
+  CHECK( cutoff % 4, "Cutoff must be a multiple of four" );
+  CHECK( cutoff > trSize, "Cutoff must not be larger than transformation size" );
+
+  std::ostringstream sstm;
+  sstm << "fastFwdCore_2D trSize=" << trSize << " line=" << line << " reducedLine=" << reducedLine
+       << " cutoff=" << cutoff;
+
+  TCoeff       *src_vvenc  = ( TCoeff* )       xMalloc( TCoeff,       trSize * line );
+  TCoeff       *src_kvcl  = ( TCoeff* )     xMalloc( TCoeff,       trSize * line );
+  TCoeff       *dst_vvenc = ( TCoeff* )       xMalloc( TCoeff,       trSize * line );
+  TCoeff       *dst_kvcl = ( TCoeff* )       xMalloc( TCoeff,       trSize * line );
+
+  // Initialize source and destination buffers, make sure that destination
+  // buffers match in elements that are not written to by the kernel being
+  // tested.
+  std::generate( src_vvenc, src_vvenc + trSize * line,  input_generator );
+  for (int i = 0; i < trSize * line; ++i) {
+    src_kvcl[i] = src_vvenc[i];
+  }
+  memset( dst_vvenc, 0, trSize * line * sizeof( TCoeff ) );
+  memset( dst_kvcl, 0, trSize * line * sizeof( TCoeff ) );
+
+  // Time DCT2 (vvenc reference)
+  auto t0 = std::chrono::high_resolution_clock::now();
+  ref->DCT2[idx](src_vvenc, dst_vvenc, line, trSize - cutoff, line - reducedLine);
+  auto t1 = std::chrono::high_resolution_clock::now();
+  elapsed_vvenc_us = std::chrono::duration<double, std::micro>(t1 - t0).count();
+
+  // Time KvclVvcDct16x16 (KVCL implementation)
+  auto t2 = std::chrono::high_resolution_clock::now();
+  ref->DCT2_KVCL[idx](src_kvcl, dst_kvcl, line, cutoff, reducedLine);
+  auto t3 = std::chrono::high_resolution_clock::now();
+  elapsed_kvcl_us = std::chrono::duration<double, std::micro>(t3 - t2).count();
+
+  bool ret = true;
+  for (int i = 0; i < trSize * trSize; ++i) {
+    if(dst_kvcl[i] != dst_vvenc[i]) {
+      ret = false;
+      printf("dst_kvcl[%d] = %d, dst_vvenc[%d] = %d\n", i, dst_kvcl[i], i, dst_vvenc[i]);
+      break;
+    }
+  }
+
+  xFree( src_vvenc );
+  xFree( src_kvcl );
+  xFree( dst_vvenc );
+  xFree( dst_kvcl );
+
+  return ret;
+}
+
+static bool check_KVCL_DCT2( TCoeffOps* ref, unsigned num_cases, unsigned idx, unsigned trSize )
+{
+  printf( "Testing TCoeffOps::KVCL_DCT2 trSize=%d\n", trSize );
+  InputGenerator<TCoeff> g{ 8 }; // signed 8 bit in both positive/negative, i.e. 9 bit shifted to signed
+  DimensionGenerator rng;
+
+  double total_vvenc_us = 0.0;
+  double total_kvcl_us  = 0.0;
+
+  for( unsigned i = 0; i < num_cases; ++i )
+  {
+    // Clamp line down to the next multiple of four when generating reducedLine
+    // to avoid existing x86 implementations over-writing.
+    unsigned line        = trSize;//1 << rng.get( 1, 6 );
+    unsigned reducedLine = rng.get( 1, line, 1 );//rng.get( 1, line, 1 ); //trSize ==  64 ? 32 : line; // == 2 ? 2 : std::min( 32u, rng.get( 4, line, 4 ) );
+    unsigned cutoff      = rng.get( 4, trSize, 4 ); //trSize == 64 ? 32 : trSize; //rng.get( 4, trSize, 4 );  // Cutoff must be a non-zero multiple of four.
+    double elapsed_vvenc_us = 0.0;
+    double elapsed_kvcl_us  = 0.0;
+    if( !check_one_KVCL_DCT2( ref, idx, trSize, line, reducedLine, cutoff, g, elapsed_vvenc_us, elapsed_kvcl_us) )
+    {
+      return false;
+    }
+    total_vvenc_us += elapsed_vvenc_us;
+    total_kvcl_us  += elapsed_kvcl_us;
+  }
+
+  printf( "  runs=%u  DCT2_%dx%d total: %.2f us (avg: %.2f us)  KvclVvcDct%dx%d total: %.2f us (avg: %.2f us)\n",
+          num_cases, trSize, trSize, total_vvenc_us, total_vvenc_us / num_cases, trSize, trSize, total_kvcl_us, total_kvcl_us / num_cases );
+
+  return true;
+}
+
+
+
 template<typename G, typename T>
 static bool check_one_fastFwdCore_2D( TCoeffOps* ref, TCoeffOps* opt, unsigned idx, unsigned trSize, unsigned line,
                                       unsigned reducedLine, unsigned cutoff, unsigned shift, G input_generator, T trafo_generator )
@@ -591,6 +685,10 @@ static bool test_TCoeffOps()
   passed = check_fastFwdCore_2D( &ref, &opt, num_cases, 2, 16 ) && passed;
   passed = check_fastFwdCore_2D( &ref, &opt, num_cases, 3, 32 ) && passed;
   passed = check_fastFwdCore_2D( &ref, &opt, num_cases, 4, 64 ) && passed;
+  passed = check_KVCL_DCT2( &opt, 100000, 0, 16 ) && passed;
+  passed = check_KVCL_DCT2( &opt, 100000, 1, 32 ) && passed;
+  passed = check_KVCL_DCT2( &opt, 100000, 2, 64 ) && passed;
+
   return passed;
 }
